# Aplicación
APP_NODE=development
APP_PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=prueba_db

# JWT: utiliza un secreto de al menos 32 caracteres
JWT_SECRET=desarrollo-local-secreto-cambiar-por-uno-seguro
JWT_EXPIRES_IN=3600

# API Keys para integraciones externas
API_KEYS=demo-key-partner-1,demo-key-partner-2

# Administrador inicial
ADMIN_EMAIL=admin@fleetcore.local
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Administrador FleetCore